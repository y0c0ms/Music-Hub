<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      The system bars are painted to match the app.

      This file is the LIGHT variant; values-night/styles.xml is the dark one.
      The bar COLOUR comes from @color/appBackground, which already resolves per
      mode, so only the icon polarity has to be stated twice.

      windowLight*Bar controls the ICONS, and it is confusingly named: TRUE means
      dark icons, for a light bar. It is set true here and false in values-night.
      Previously it was pinned false for both, which was right when the app was
      dark-only and would now put white icons on a white bar - invisible.

      Both attributes are newer than minSdk 22; older releases ignore attributes
      they do not know, and their icons were already light by default.

      Known edge: these follow the DEVICE theme, while Settings > Appearance can
      override the page independently. Forcing Light on a dark phone therefore
      leaves the bars dark around a light page. Android gives an app no way to
      re-evaluate a -night resource against anything but the system setting, short
      of recreating the activity, and that is not worth a relaunch on every toggle.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <item name="android:navigationBarColor">@color/appBackground</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Match the app during the splash too, or the bars flash white on launch. -->
        <item name="android:navigationBarColor">@color/appBackground</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
